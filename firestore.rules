rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared data: sessions, lobby, suggestions, contact messages, approved
    // words, etc. Anyone can read (needed for opponents/host to sync state).
    // Writes require at least an anonymous auth token, so a bot with zero
    // credentials can't hammer the database.
    match /shared/{key} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Personal data (profile): only the owning device's anonymous account
    // can read or write its own documents.
    match /users/{uid}/data/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
